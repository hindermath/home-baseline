#!/usr/bin/env bash
# pre-push Hook: Blockiert den Push, wenn Secrets in git-getrackten Dateien gefunden werden.
# Scannt NUR Dateien, die tatsächlich in diesem Repository verwaltet werden (.gitignore wird respektiert).
# Installation: scripts/install-hooks.sh ausführen

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
push_remote_name="${1:-}"
push_remote_url="${2:-}"
zero_sha="0000000000000000000000000000000000000000"
regex_files=()
regex_commits=()
remote_baseline=()
push_updates=()

while IFS= read -r push_update; do
  [ -n "$push_update" ] && push_updates+=("$push_update")
done

secret_content_regex="((id_token|access_token|refresh_token|api[_-]?key|client[_-]?secret|password)[[:space:]]*[:=][[:space:]]*['\"]?[A-Za-z0-9._~+/=-]{8,}|--api-key[[:space:]]+[^[:space:];]{8,}|authorization:[[:space:]]*bearer[[:space:]]+[A-Za-z0-9._~+/=-]{8,}|bearer[[:space:]]+[A-Za-z0-9._~+/=-]{20,}|(^|[^A-Za-z0-9])sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA|OPENSSH|EC|DSA) PRIVATE KEY-----)"
secret_name_regex='(auth\.json|(^|\/)\.env(\.[^.]+)?$|[^/]*(secret|credential|creds)[^/]*\.(json|yaml|yml|xml|ini|cfg|conf|toml)|[^/]*id_rsa[^/]*|[^/]*\.(pem|key|p12|pfx))$'
allowed_secret_name_regex='(^|/)\.env\.(example|sample|template|dist)$'

echo "pre-push: Prüfe git-getrackte Dateien auf Secrets …"

secret_content_present() {
  local relative_path="$1"
  local grep_option="${2:--E}"
  # DE: Ein aus der Prozessumgebung gelesener CLI-Wert ist kein eingebettetes Secret.
  # EN: A CLI value read from the process environment is not an embedded secret.
  # Keep literal values and every other detector input unchanged.
  if [ "$relative_path" = "scripts/hooks/pre-push" ] \
    || [ "$relative_path" = "scripts/scan-agent-secrets.sh" ] \
    || [ "$relative_path" = "scripts/lib/hg-secrets.sh" ]; then
    sed -E '/^(secret_content_regex|HG_SECRET_PATTERNS)=/d' \
      | grep "$grep_option" "$secret_content_regex" > /dev/null
  elif [ "$relative_path" = "scripts/scan-agent-secrets.ps1" ]; then
    awk '
      /^\$SecretContentPatterns[[:space:]]*=[[:space:]]*@\(/ { in_patterns=1; next }
      in_patterns && /^\)[[:space:]]*$/ { in_patterns=0; next }
      !in_patterns { print }
    ' | grep "$grep_option" "$secret_content_regex" > /dev/null
  elif [ "$relative_path" = "scripts/lib/hg-secrets.ps1" ]; then
    sed -E '/^\$HG_SECRET_PATTERN[[:space:]]*=/d' \
      | grep "$grep_option" "$secret_content_regex" > /dev/null
  elif [[ "$relative_path" == .github/workflows/* ]]; then
    sed -E 's/--api-key[[:blank:]]+\$env:[A-Za-z_][A-Za-z0-9_]*([[:blank:];]|$)/\1/g' \
      | grep "$grep_option" "$secret_content_regex" > /dev/null
  else
    grep "$grep_option" "$secret_content_regex" > /dev/null
  fi
}

regex_file_known() {
  local candidate="$1"
  local existing
  for existing in "${regex_files[@]+"${regex_files[@]}"}"; do
    [ "$existing" = "$candidate" ] && return 0
  done
  return 1
}

add_regex_file() {
  local rel_file="$1"
  local abs_file=""

  [ -n "$rel_file" ] || return 0
  if ! git -C "$REPO_ROOT" ls-files --error-unmatch -- "$rel_file" >/dev/null 2>&1; then
    return 0
  fi

  abs_file="$REPO_ROOT/$rel_file"
  regex_file_known "$abs_file" && return 0
  regex_files+=("$abs_file")
}

load_remote_baseline() {
  local remote_target="${1:-${2:-}}"
  local refs sha ref_name
  remote_baseline=()
  [ -n "$remote_target" ] || return 2
  refs="$(git -C "$REPO_ROOT" ls-remote "$remote_target" 'refs/heads/*' 'refs/tags/*')" || return 2
  while read -r sha ref_name; do
    [ -n "$sha" ] || continue
    if git -C "$REPO_ROOT" cat-file -e "$sha^{commit}" 2>/dev/null; then
      remote_baseline+=("$sha")
    fi
  done <<< "$refs"
}

collect_regex_files_for_existing_ref() {
  local remote_sha="$1"
  local local_sha="$2"
  local rel_file

  while IFS= read -r rel_file; do
    add_regex_file "$rel_file"
  done < <(git -C "$REPO_ROOT" diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)

  while IFS= read -r commit; do
    [ -n "$commit" ] && regex_commits+=("$commit")
  done < <(git -C "$REPO_ROOT" rev-list "$remote_sha..$local_sha")
}

collect_regex_files_for_new_ref() {
  local local_sha="$1"
  local commit rel_file
  local commits=""

  # Exclude only commits confirmed on this push's destination remote.
  # Local tracking refs for another remote are not proof of destination state.
  if [ "${#remote_baseline[@]}" -gt 0 ]; then
    commits="$(git -C "$REPO_ROOT" rev-list "$local_sha" --not "${remote_baseline[@]}")"
  else
    commits="$(git -C "$REPO_ROOT" rev-list "$local_sha")"
  fi

  while IFS= read -r commit; do
    [ -n "$commit" ] || continue
    regex_commits+=("$commit")
    while IFS= read -r rel_file; do
      add_regex_file "$rel_file"
    done < <(git -C "$REPO_ROOT" diff-tree --root --no-commit-id --name-only -r "$commit" 2>/dev/null || true)
  done < <(printf '%s\n' "$commits")
}

scan_regex_commit_blobs() {
  local commit rel_file blob_ref

  # Scan the version in every outgoing commit, including files later deleted.
  # Current worktree paths alone cannot prove pushed history is secret-free.
  for commit in "${regex_commits[@]+"${regex_commits[@]}"}"; do
    while IFS= read -r -d '' rel_file; do
      if [[ "$rel_file" != .github/workflows/* ]] \
        && ! printf '%s\n' "$rel_file" | grep -Eiq "$allowed_secret_name_regex" \
        && printf '%s\n' "$rel_file" | grep -Eiq "$secret_name_regex"; then
        echo "  HIGH: Secret-ähnlicher Dateiname in Push-Historie: $rel_file" >&2
        return 2
      fi
      blob_ref="$commit:$rel_file"
      if git -C "$REPO_ROOT" cat-file -e "$blob_ref" 2>/dev/null \
        && git -C "$REPO_ROOT" cat-file blob "$blob_ref" | secret_content_present "$rel_file" -Ei; then
        echo "  HIGH: Secret-Muster in Push-Historie: $rel_file ($commit)" >&2
        return 2
      fi
    done < <(git -C "$REPO_ROOT" diff-tree --root -m --no-commit-id --name-only -r -z "$commit")
  done
}

run_gitleaks_range_scan() {
  local gitleaks_available=1
  if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-push: gitleaks nicht gefunden; Regex-Fallback bleibt aktiv."
    gitleaks_available=0
  fi

  local local_ref local_sha remote_ref remote_sha
  local scanned=0
  local status=0
  local log_opts=""

  local push_update
  for push_update in "${push_updates[@]+"${push_updates[@]}"}"; do
    read -r local_ref local_sha remote_ref remote_sha <<< "$push_update"
    [ -n "${local_sha:-}" ] || continue

    if [ "$local_sha" = "$zero_sha" ]; then
      continue
    fi

    if [ "${remote_sha:-$zero_sha}" = "$zero_sha" ]; then
      log_opts="$local_sha"
      if ! load_remote_baseline "$push_remote_name" "$push_remote_url"; then
        echo "pre-push: Ziel-Remote fuer neue Ref nicht pruefbar / destination remote unavailable." >&2
        return 2
      fi
      if [ "${#remote_baseline[@]}" -gt 0 ]; then
        log_opts="$local_sha --not ${remote_baseline[*]}"
      fi
      collect_regex_files_for_new_ref "$local_sha"
    else
      if ! git -C "$REPO_ROOT" cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        echo "pre-push: Remote-Basiscommit ist lokal nicht pruefbar / remote base commit is unavailable locally." >&2
        return 2
      fi
      if [ -z "$(git -C "$REPO_ROOT" rev-list --max-count=1 "$remote_sha..$local_sha" 2>/dev/null || true)" ]; then
        continue
      fi
      log_opts="$remote_sha..$local_sha"
      collect_regex_files_for_existing_ref "$remote_sha" "$local_sha"
    fi

    scanned=1
    if [ "$gitleaks_available" -eq 1 ]; then
      echo "pre-push: gitleaks prüft zu pushende Commits (${remote_ref:-$local_ref}) …"
      set +e
      gitleaks git --redact --no-banner --no-color --log-level warn --exit-code 2 --log-opts="$log_opts" "$REPO_ROOT"
      status=$?
      set -e

      if [ "$status" -ne 0 ]; then
        echo "  HIGH: gitleaks hat mögliche Secrets in zu pushenden Commits gefunden oder konnte den Scan nicht abschließen." >&2
        return 2
      fi
    fi
  done

  if [ "$gitleaks_available" -eq 0 ]; then
    return 0
  elif [ "$scanned" -eq 0 ]; then
    echo "pre-push: gitleaks hatte keine neuen Commit-Ranges zu prüfen."
  else
    echo "pre-push: gitleaks-Scan ohne Befund."
  fi
}

verify_ci_gate_evidence() {
  local profiles="${HB_CI_PROFILES:-${REPO_ROOT}/scripts/config/ci-budget-profiles.json}"
  local path_contracts="${HB_CI_PATH_CONTRACTS:-${REPO_ROOT}/scripts/config/ci-budget-path-contracts.json}"
  local workflow_template="${HB_CI_WORKFLOW_TEMPLATE:-${REPO_ROOT}/scripts/templates/ci-budget-governance/private-governance-minimal-gate.yml}"
  local evidence_root="${HB_CI_EVIDENCE_ROOT:-${HOME}/.home-baseline/evidence/ci-gates}"
  local engine="${REPO_ROOT}/scripts/lib/agentic_workspace_fleet.py"
  local repository_id="${HB_CI_REPOSITORY_ID:-}"
  local profile_record visibility profile_name push_update
  local local_ref local_sha remote_ref remote_sha expected_hash preview_output evidence_file changed_output changed_path checked_out_head
  local -a preview_arguments=()

  [ -f "$profiles" ] || { echo "pre-push: CI-Profilregistry fehlt / profile registry missing." >&2; return 2; }
  [ -f "$path_contracts" ] || { echo "pre-push: CI-Pfadregistry fehlt / path registry missing." >&2; return 2; }
  [ -f "$workflow_template" ] || { echo "pre-push: CI-Workflowvertrag fehlt / workflow contract missing." >&2; return 2; }
  [ -f "$engine" ] || { echo "pre-push: CI-Engine fehlt / engine missing." >&2; return 2; }

  if [ -z "$repository_id" ]; then
    repository_id="$(python3 - "$REPO_ROOT" "$profiles" <<'PY'
import json
import pathlib
import subprocess
import sys
from urllib.parse import urlsplit


def normalized(value):
    value = value.strip().replace('\\', '/')
    parsed = urlsplit(value)
    if parsed.scheme in {'http', 'https'}:
        value = f"{parsed.scheme.lower()}://{parsed.netloc.lower()}{parsed.path}"
    return value.rstrip('/').removesuffix('.git').lower()


root = pathlib.Path(sys.argv[1])
registry = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding='utf-8-sig'))
origin = subprocess.run(
    ['git', '-C', str(root), 'remote', 'get-url', 'origin'],
    text=True, capture_output=True, check=False,
)
if origin.returncode != 0:
    raise SystemExit(2)
remote = normalized(origin.stdout)
if remote.endswith('/home-baseline'):
    print('home-baseline')
    raise SystemExit(0)
manifest = json.loads((root / registry['fleetManifestPath']).read_text(encoding='utf-8-sig'))
matches = [
    item['id'] for item in manifest['targets']
    if item.get('active') and item.get('kind') == 'git-repository'
    and normalized(item.get('remote', '')) == remote
]
if len(matches) != 1:
    raise SystemExit(2)
print(matches[0])
PY
)" || { echo "pre-push: Repository-ID kann nicht eindeutig aufgeloest werden / cannot be resolved uniquely." >&2; return 2; }
  fi

  profile_record="$(python3 - "$profiles" "$repository_id" <<'PY'
import json
import pathlib
import sys

registry = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding='utf-8-sig'))
repository_id = sys.argv[2]
assignments = [item for item in registry.get('assignments', []) if item.get('repositoryId') == repository_id]
if len(assignments) != 1:
    raise SystemExit(2)
profiles = [item for item in registry.get('profiles', []) if item.get('profileId') == assignments[0].get('profileId')]
if len(profiles) != 1:
    raise SystemExit(2)
print(f"{profiles[0]['requiredVisibility']}\t{profiles[0]['displayName']}")
PY
)" || { echo "pre-push: Profilzuordnung fehlt oder ist mehrdeutig / profile assignment missing or ambiguous." >&2; return 2; }
  IFS=$'\t' read -r visibility profile_name <<< "$profile_record"
  [ "$visibility" = "private" ] || return 0

  for push_update in "${push_updates[@]+"${push_updates[@]}"}"; do
    read -r local_ref local_sha remote_ref remote_sha <<< "$push_update"
    [ -n "${local_sha:-}" ] || continue
    [ "$local_sha" != "$zero_sha" ] || continue
    checked_out_head="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null)" || return 2
    if [ "$local_sha" != "$checked_out_head" ]; then
      echo "pre-push: Ausgehender Commit ist nicht der geprüfte HEAD / outgoing commit is not the tested HEAD." >&2
      return 1
    fi
    if [ "$remote_sha" = "$zero_sha" ]; then
      changed_output="$(git -C "$REPO_ROOT" ls-tree -r --name-only "$local_sha")" || return 2
    else
      changed_output="$(git -C "$REPO_ROOT" diff --name-only "$remote_sha" "$local_sha")" || return 2
    fi
    preview_arguments=()
    while IFS= read -r changed_path; do
      [ -n "$changed_path" ] && preview_arguments+=(--changed-path "$changed_path")
    done <<< "$changed_output"
    preview_output="$(python3 "$engine" ci-gate \
      --repository-root "$REPO_ROOT" \
      --profiles "$profiles" \
      --path-contracts "$path_contracts" \
      --workflow-template "$workflow_template" \
      --repository-id "$repository_id" \
      --fixture-head "$local_sha" \
      --evidence-root "$evidence_root" \
      "${preview_arguments[@]}" \
      --dry-run)" || return $?
    expected_hash="$(printf '%s\n' "$preview_output" | sed -n 's/^Gate-Set-Hash: //p')"
    [ -n "$expected_hash" ] || { echo "pre-push: Gate-Set-Hash fehlt / is missing." >&2; return 2; }
    evidence_file="${evidence_root}/${repository_id}/${local_sha}.json"
    python3 - "$evidence_file" "$repository_id" "$local_sha" "$profile_name" "$expected_hash" <<'PY' || return $?
import json
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
if not path.is_file() or path.is_symlink():
    print('pre-push: passende CI-Gate-Evidence fehlt / matching evidence is missing.', file=sys.stderr)
    raise SystemExit(1)
try:
    value = json.loads(path.read_text(encoding='utf-8'))
except (OSError, UnicodeError, json.JSONDecodeError):
    print('pre-push: CI-Gate-Evidence ist ungueltig / invalid.', file=sys.stderr)
    raise SystemExit(1)
expected = {
    'schemaVersion', 'repositoryId', 'headCommit', 'ciProfile', 'gateSetHash',
    'platform', 'generatedAt', 'hookVersion', 'status', 'results',
}
valid = (
    set(value) == expected
    and value.get('schemaVersion') == '1.0'
    and value.get('repositoryId') == sys.argv[2]
    and value.get('headCommit') == sys.argv[3]
    and value.get('ciProfile') == sys.argv[4]
    and value.get('gateSetHash') == sys.argv[5]
    and value.get('hookVersion') == '1.0.0'
    and value.get('status') == 'Passed'
    and isinstance(value.get('results'), list)
    and bool(value['results'])
    and all(
        item.get('status') == 'Passed' and item.get('exitCode') == 0
        for item in value['results'] if isinstance(item, dict)
    )
    and all(isinstance(item, dict) for item in value['results'])
)
if not valid:
    print('pre-push: CI-Gate-Evidence ist alt oder inkonsistent / stale or inconsistent.', file=sys.stderr)
    raise SystemExit(1)
PY
  done
}

if ! verify_ci_gate_evidence; then
  echo "pre-push: Push wegen fehlender oder inkonsistenter privater CI-Evidence blockiert." >&2
  exit 1
fi

if ! run_gitleaks_range_scan; then
  echo "" >&2
  echo "╔══════════════════════════════════════════════════════════════╗" >&2
  echo "║  PUSH ABGEBROCHEN: gitleaks hat Secrets erkannt!            ║" >&2
  echo "║  Bitte Befund bereinigen, Secret rotieren und erneut pushen. ║" >&2
  echo "╚══════════════════════════════════════════════════════════════╝" >&2
  exit 2
fi

if ! command -v gitleaks >/dev/null 2>&1 && ! scan_regex_commit_blobs; then
  echo "pre-push: Push wegen Secret-Mustern in ausgehenden Commits abgebrochen." >&2
  exit 2
fi

# Nur geaenderte Dateien aus den Push-Ranges pruefen, die git kennt (respektiert .gitignore).
tracked_files=()
for f in "${regex_files[@]+"${regex_files[@]}"}"; do
  tracked_files+=("$f")
done

if [ "${#tracked_files[@]}" -eq 0 ]; then
  echo "pre-push: Keine geänderten getrackten Dateien für Regex-Fallback gefunden."
fi

found_high=0

# Dateinamen mit Secret-ähnlichen Namen
name_hits=()
if [ "${#tracked_files[@]}" -gt 0 ]; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if printf '%s\n' "$f" | grep -Eiq "$allowed_secret_name_regex"; then
      continue
    fi
    name_hits+=("$f")
  done < <(printf '%s\n' "${tracked_files[@]}" | grep -Ei "$secret_name_regex" | grep -v '\.github/workflows/' || true)
fi

if [ "${#name_hits[@]}" -gt 0 ]; then
  found_high=1
  echo "  HIGH: Secret-ähnliche Dateinamen gefunden:" >&2
  printf '       %s\n' "${name_hits[@]}" >&2
fi

# Dateiinhalte mit Secret-Mustern
content_hits=()
if [ "${#tracked_files[@]}" -gt 0 ]; then
  while IFS= read -r f; do
    content_hits+=("$f")
  done < <(
    for candidate in "${tracked_files[@]}"; do
      if secret_content_present "${candidate#"$REPO_ROOT/"}" < "$candidate"; then
        printf '%s\n' "$candidate"
      fi
    done
  )
fi

if [ "${#content_hits[@]}" -gt 0 ]; then
  found_high=1
  echo "  HIGH: Secret-Muster im Dateiinhalt gefunden:" >&2
  printf '       %s\n' "${content_hits[@]}" >&2
fi

# ~/.gitconfig.d/ auf Credential-Muster scannen
gitconfig_d="${HOME}/.gitconfig.d"
if [ -d "$gitconfig_d" ]; then
  inc_hits=()
  while IFS= read -r f; do
    inc_hits+=("$f")
  done < <(grep -rEl --include='*.inc' "$secret_content_regex" "$gitconfig_d" 2>/dev/null || true)
  if [ "${#inc_hits[@]}" -gt 0 ]; then
    found_high=1
    echo "  HIGH: Secret-Muster in ~/.gitconfig.d/ gefunden / Secret patterns found in ~/.gitconfig.d/:" >&2
    printf '       %s\n' "${inc_hits[@]}" >&2
  fi
fi

if [ "$found_high" -eq 1 ]; then
  echo "" >&2
  echo "╔══════════════════════════════════════════════════════════════╗" >&2
  echo "║  PUSH ABGEBROCHEN: Mögliche Secrets in getrackten Dateien!  ║" >&2
  echo "║  Bitte die markierten Dateien bereinigen und erneut pushen.  ║" >&2
  echo "╚══════════════════════════════════════════════════════════════╝" >&2
  exit 2
fi

echo "pre-push: Keine Secrets in getrackten Dateien. Push wird fortgesetzt."
exit 0
