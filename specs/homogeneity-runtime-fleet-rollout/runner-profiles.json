{
  "schemaVersion": "1.1",
  "profiles": {
    "codex-bounded-tooling": {
      "agentFamily": "Codex",
      "model": null,
      "reasoningEffort": null,
      "executable": "codex",
      "arguments": [
        "exec",
        "--cd",
        "{worktree}",
        "{prompt}"
      ]
    }
  },
  "mergeProfiles": {
    "github-pr": {
      "provider": "GitHub",
      "preflight": {
        "executable": "gh",
        "arguments": ["pr", "view", "{prUrl}", "--json", "headRefOid,mergeable,reviewDecision,statusCheckRollup"]
      },
      "merge": {
        "executable": "gh",
        "arguments": ["pr", "merge", "{prUrl}", "--merge"]
      }
    }
  },
  "postMergeProfiles": {
    "git-sync-main": {
      "idempotent": true,
      "executable": "git",
      "arguments": ["-C", "{repository}", "pull", "--ff-only", "origin", "main"]
    },
    "validate-homogeneity-runtime": {
      "idempotent": true,
      "executable": "bash",
      "arguments": [
        "/Users/thorstenhindermann/home-baseline-source/scripts/test-homogeneity-runtime-closure.sh",
        "{repository}"
      ]
    }
  }
}
