{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hindermath/home-baseline/schemas/stage-b-ruleset-plan.schema.json",
  "title": "Stage B Private Governance Ruleset Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rulesetPlanId", "runId", "repositoryId", "profileId", "providerRepositoryId", "defaultBranch", "rulesetName", "previousRulesetId", "previousRulesetHash", "desiredRulesetHash", "action", "target", "enforcement", "pullRequestRequired", "requiredApprovingReviews", "requiredStatusChecks", "strictStatusChecks", "bypassActors", "blockedWritePaths", "adminBypassNormalPath", "restoreRequestHash", "planHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "rulesetPlanId": { "type": "string", "format": "uuid", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
    "runId": { "type": "string", "format": "uuid", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
    "repositoryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "profileId": { "const": "private-governance-scaffold" },
    "providerRepositoryId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "defaultBranch": { "type": "string", "minLength": 1, "maxLength": 255 },
    "rulesetName": { "const": "home-baseline/private-governance-default" },
    "previousRulesetId": { "type": "string", "pattern": "^(?:N/A|[1-9][0-9]*)$" },
    "previousRulesetHash": { "$ref": "#/$defs/sha256OrNA" },
    "desiredRulesetHash": { "$ref": "#/$defs/sha256" },
    "action": { "enum": ["Create", "Update", "NoChange"] },
    "target": { "const": "default_branch" },
    "enforcement": { "const": "active" },
    "pullRequestRequired": { "const": true },
    "requiredApprovingReviews": { "const": 1 },
    "requiredStatusChecks": { "const": ["home-baseline/ci-minimal-gate"] },
    "strictStatusChecks": { "const": true },
    "bypassActors": { "const": [] },
    "blockedWritePaths": { "const": ["direct", "web", "api"] },
    "adminBypassNormalPath": { "const": false },
    "restoreRequestHash": { "$ref": "#/$defs/sha256" },
    "planHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256OrNA": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "const": "N/A" }] }
  }
}
