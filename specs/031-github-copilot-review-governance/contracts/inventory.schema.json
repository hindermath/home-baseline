{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hindermath.example/schemas/copilot-review-governance/inventory.schema.json",
  "title": "Copilot Review Governance Current Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "runId",
    "observedAt",
    "expiresAt",
    "apiVersion",
    "complete",
    "sourceFresh",
    "pagination",
    "billingUsage",
    "personalAccountAutomation",
    "repositories",
    "rulesets",
    "browserEvidence",
    "reviewTriggers",
    "redactionFindings",
    "snapshotSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "snapshotId": { "type": "string", "format": "uuid" },
    "runId": { "type": "string", "format": "uuid" },
    "observedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "apiVersion": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "complete": { "const": true },
    "sourceFresh": { "const": true },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoriesPages", "rulesetListPages", "rulesetDetailsRead", "truncated"],
      "properties": {
        "repositoriesPages": { "type": "integer", "minimum": 1 },
        "rulesetListPages": { "type": "integer", "minimum": 0 },
        "rulesetDetailsRead": { "type": "integer", "minimum": 0 },
        "truncated": { "const": false }
      }
    },
    "billingUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["billingOwnerType", "aiCredits", "actionsMinutes"],
      "properties": {
        "billingOwnerType": { "enum": ["Personal", "Organization", "Enterprise", "Unknown"] },
        "aiCredits": { "$ref": "#/$defs/usage" },
        "actionsMinutes": { "$ref": "#/$defs/usage" }
      }
    },
    "personalAccountAutomation": { "$ref": "#/$defs/browserState" },
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository" }
    },
    "rulesets": {
      "type": "array",
      "items": { "$ref": "#/$defs/ruleset" }
    },
    "browserEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/browserEvidence" }
    },
    "reviewTriggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic", "manual", "unknown", "observedAt"],
      "properties": {
        "automatic": { "type": "integer", "minimum": 0 },
        "manual": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "redactionFindings": { "const": 0 },
    "snapshotSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unit", "periodStart", "periodEnd", "source", "observedAt"],
      "properties": {
        "status": { "enum": ["Known", "Unknown", "NotApplicable"] },
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 80 },
        "periodStart": { "type": "string", "format": "date-time" },
        "periodEnd": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "minLength": 1, "maxLength": 200 },
        "observedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "Known" } } },
          "then": { "required": ["value"] }
        }
      ]
    },
    "browserState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidenceMode", "observedAt", "evidenceSha256"],
      "properties": {
        "state": { "enum": ["Enabled", "Disabled", "Unknown"] },
        "evidenceMode": { "const": "BrowserManual" },
        "observedAt": { "type": "string", "format": "date-time" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "slug", "visibility", "defaultBranch", "ownedByAccount"],
      "properties": {
        "repositoryId": { "type": "integer", "minimum": 1 },
        "slug": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "visibility": { "enum": ["public", "private", "internal"] },
        "defaultBranch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "ownedByAccount": { "const": true }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "rulesetId",
        "name",
        "sourceType",
        "target",
        "enforcement",
        "conditionsSha256",
        "rulesSha256",
        "containsCopilotCodeReview",
        "mixedPurpose",
        "stateSha256"
      ],
      "properties": {
        "repositoryId": { "type": "integer", "minimum": 1 },
        "rulesetId": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sourceType": { "enum": ["Repository", "Organization", "Enterprise"] },
        "target": { "enum": ["branch", "tag", "push"] },
        "enforcement": { "enum": ["active", "disabled", "evaluate"] },
        "conditionsSha256": { "$ref": "#/$defs/sha256" },
        "rulesSha256": { "$ref": "#/$defs/sha256" },
        "containsCopilotCodeReview": { "type": "boolean" },
        "mixedPurpose": { "type": "boolean" },
        "reviewDraftPullRequests": { "type": "boolean" },
        "reviewOnPush": { "type": "boolean" },
        "stateSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "browserEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "observedState", "observedAt", "reviewedAt", "operatorRole", "reviewerRole", "uiPathClass", "evidenceSha256"],
      "properties": {
        "surface": { "enum": ["PersonalAccountAutomation", "RepositoryEffort", "ManualReviewAvailability"] },
        "repositoryId": { "type": "integer", "minimum": 1 },
        "observedState": { "enum": ["Enabled", "Disabled", "Lite", "Balanced", "Available", "Unavailable", "Unknown"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "operatorRole": { "type": "string", "minLength": 1, "maxLength": 80 },
        "reviewerRole": { "type": "string", "minLength": 1, "maxLength": 80 },
        "uiPathClass": { "type": "string", "minLength": 1, "maxLength": 160 },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
