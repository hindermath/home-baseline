{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hindermath.example/schemas/copilot-review-governance/mutation-plan.schema.json",
  "title": "Copilot Review Governance Mutation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "runId", "desiredStateSha256", "inventorySha256", "apiVersion", "createdAt", "expiresAt", "actions", "planSha256"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "planId": { "type": "string", "format": "uuid" },
    "runId": { "type": "string", "format": "uuid" },
    "desiredStateSha256": { "$ref": "#/$defs/sha256" },
    "inventorySha256": { "$ref": "#/$defs/sha256" },
    "apiVersion": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "planSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "idempotencyId", "operationClass", "action", "writeIntent", "allowedMethod", "beforeSha256", "desiredSha256", "rollbackSha256", "payloadPath", "rationale"],
      "properties": {
        "actionId": { "type": "string", "format": "uuid" },
        "idempotencyId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "operationClass": { "enum": ["AccountSetting", "EffortLevel", "RulesetCreate", "RulesetUpdate", "RulesetDisable", "PRLifecycleAcceptance", "ManualReviewAcceptance"] },
        "action": { "enum": ["NoOp", "Update", "Create", "Disable", "Blocked"] },
        "writeIntent": { "type": "boolean" },
        "accountOwner": {
          "$comment": "Exact AccountSetting identity; it must equal the current explicit authority record and the downstream gate, result, and account rollback.",
          "const": "hindermath"
        },
        "repositoryId": { "type": "integer", "minimum": 1 },
        "rulesetId": { "type": "integer", "minimum": 1 },
        "allowedMethod": { "enum": ["None", "POST", "PUT", "BrowserManual"] },
        "beforeSha256": { "$ref": "#/$defs/sha256" },
        "desiredSha256": { "$ref": "#/$defs/sha256" },
        "rollbackSha256": { "$ref": "#/$defs/sha256" },
        "payloadPath": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "operationClass": { "const": "AccountSetting" } } },
          "then": {
            "required": ["accountOwner"],
            "not": {
              "anyOf": [
                { "required": ["repositoryId"] },
                { "required": ["rulesetId"] }
              ]
            }
          },
          "else": {
            "required": ["repositoryId"],
            "not": { "required": ["accountOwner"] }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["NoOp", "Blocked"] } } },
          "then": { "properties": { "writeIntent": { "const": false }, "allowedMethod": { "const": "None" } } }
        },
        {
          "if": { "properties": { "action": { "enum": ["Update", "Disable"] } } },
          "then": { "properties": { "writeIntent": { "const": true } } }
        },
        {
          "if": { "properties": { "action": { "const": "Create" } } },
          "then": { "properties": { "operationClass": { "const": "RulesetCreate" }, "writeIntent": { "const": true }, "allowedMethod": { "const": "POST" } } }
        },
        {
          "if": { "properties": { "operationClass": { "const": "RulesetCreate" } } },
          "then": {
            "required": ["repositoryId"],
            "properties": {
              "action": { "enum": ["NoOp", "Create", "Blocked"] },
              "allowedMethod": { "enum": ["None", "POST"] }
            }
          }
        },
        {
          "if": { "properties": { "operationClass": { "const": "RulesetUpdate" } } },
          "then": {
            "required": ["repositoryId", "rulesetId"],
            "properties": {
              "action": { "enum": ["NoOp", "Update", "Blocked"] },
              "allowedMethod": { "enum": ["None", "PUT"] }
            }
          }
        },
        {
          "if": { "properties": { "operationClass": { "const": "RulesetDisable" } } },
          "then": {
            "required": ["repositoryId", "rulesetId"],
            "properties": {
              "action": { "enum": ["NoOp", "Disable", "Blocked"] },
              "allowedMethod": { "enum": ["None", "PUT"] }
            }
          }
        },
        {
          "if": { "properties": { "operationClass": { "const": "RulesetUpdate" }, "action": { "const": "Update" } }, "required": ["operationClass", "action"] },
          "then": { "properties": { "allowedMethod": { "const": "PUT" } } }
        },
        {
          "if": { "properties": { "operationClass": { "const": "RulesetDisable" }, "action": { "const": "Disable" } }, "required": ["operationClass", "action"] },
          "then": { "properties": { "allowedMethod": { "const": "PUT" } } }
        }
      ]
    }
  }
}
