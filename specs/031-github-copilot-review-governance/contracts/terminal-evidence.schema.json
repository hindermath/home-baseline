{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hindermath.example/schemas/copilot-review-governance/terminal-evidence.schema.json",
  "title": "Copilot Review Governance Terminal Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "featureId",
    "generatedAt",
    "desiredStateSha256",
    "finalInventorySha256",
    "targetRepositoryCount",
    "targetSetExact",
    "personalAccountAutomation",
    "repositoryEffortConvergedCount",
    "activeTargetRulesetCount",
    "activeNonTargetCopilotRulesetCount",
    "automaticReviewProof",
    "manualReviewProof",
    "usageEvidence",
    "platformEvidence",
    "acceptanceGates",
    "deliveryEvidence",
    "providerMutationsOutsideAuthorizedScope",
    "secretFindings",
    "position7Mutations",
    "homeSyncPerformed",
    "artifacts",
    "terminalSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "format": "uuid" },
    "featureId": { "const": "031-github-copilot-review-governance" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "desiredStateSha256": { "$ref": "#/$defs/sha256" },
    "finalInventorySha256": { "$ref": "#/$defs/sha256" },
    "targetRepositoryCount": { "const": 8 },
    "targetSetExact": { "const": true },
    "personalAccountAutomation": { "const": "Disabled" },
    "repositoryEffortConvergedCount": { "const": 8 },
    "activeTargetRulesetCount": { "const": 8 },
    "activeNonTargetCopilotRulesetCount": { "const": 0 },
    "automaticReviewProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readyOpenCount", "firstDraftToReadyCount", "draftReviewCount", "pushRereviewCount", "evidenceSha256"],
      "properties": {
        "readyOpenCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "firstDraftToReadyCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "draftReviewCount": { "const": 0 },
        "pushRereviewCount": { "const": 0 },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "manualReviewProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availabilityPreserved", "copilotAdvisoryOnly", "humanReviewPreserved", "evidenceSha256"],
      "properties": {
        "availabilityPreserved": { "const": true },
        "copilotAdvisoryOnly": { "const": true },
        "humanReviewPreserved": { "const": true },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "usageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aiCreditsReportedSeparately", "actionsMinutesReportedSeparately", "automaticManualUnknownTriggersSeparated", "fixedPriceClaims", "evidenceSha256"],
      "properties": {
        "aiCreditsReportedSeparately": { "const": true },
        "actionsMinutesReportedSeparately": { "const": true },
        "automaticManualUnknownTriggersSeparated": { "const": true },
        "fixedPriceClaims": { "const": false },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "platformEvidence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/platformRecord" }, { "properties": { "platform": { "const": "macOS" } } }] },
        { "allOf": [{ "$ref": "#/$defs/platformRecord" }, { "properties": { "platform": { "const": "Linux" } } }] },
        { "allOf": [{ "$ref": "#/$defs/platformRecord" }, { "properties": { "platform": { "const": "Windows" } } }] }
      ],
      "items": false
    },
    "acceptanceGates": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/gateRecord" }, { "properties": { "gateId": { "const": "AC-CRG-001" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateRecord" }, { "properties": { "gateId": { "const": "AC-CRG-002" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateRecord" }, { "properties": { "gateId": { "const": "AC-CRG-003" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateRecord" }, { "properties": { "gateId": { "const": "AC-CRG-004" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateRecord" }, { "properties": { "gateId": { "const": "AC-CRG-005" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateRecord" }, { "properties": { "gateId": { "const": "AC-CRG-006" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateRecord" }, { "properties": { "gateId": { "const": "AC-CRG-007" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateRecord" }, { "properties": { "gateId": { "const": "AC-CRG-008" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateRecord" }, { "properties": { "gateId": { "const": "AC-CRG-009" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateRecord" }, { "properties": { "gateId": { "const": "AC-CRG-010" } } }] }
      ],
      "items": false
    },
    "deliveryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "exactHeadSha256", "pullRequestNumber", "regularMergeAttempted", "bypassUsed", "defaultBranchSynced", "evidenceSha256"],
      "properties": {
        "branch": { "const": "031-github-copilot-review-governance" },
        "exactHeadSha256": { "$ref": "#/$defs/gitSha" },
        "pullRequestNumber": { "type": "integer", "minimum": 1 },
        "regularMergeAttempted": { "const": true },
        "protectionOnlyRefusalSha256": { "$ref": "#/$defs/sha256" },
        "bypassUsed": { "type": "boolean" },
        "defaultBranchSynced": { "const": true },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "bypassUsed": { "const": true } } },
          "then": { "required": ["protectionOnlyRefusalSha256"] }
        }
      ]
    },
    "providerMutationsOutsideAuthorizedScope": { "const": 0 },
    "secretFindings": { "const": 0 },
    "position7Mutations": { "const": 0 },
    "homeSyncPerformed": { "type": "boolean" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "classification"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "classification": { "enum": ["CommittedRedacted", "MachineLocalRestricted"] }
        }
      }
    },
    "terminalSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
    "platformRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "native", "passed", "evidencePath", "evidenceSha256"],
      "properties": {
        "platform": { "enum": ["macOS", "Linux", "Windows"] },
        "native": { "const": true },
        "passed": { "const": true },
        "evidencePath": { "$ref": "#/$defs/path" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "status", "command", "evidencePath", "evidenceSha256"],
      "properties": {
        "gateId": { "pattern": "^AC-CRG-00[1-9]$|^AC-CRG-010$" },
        "status": { "const": "Passed" },
        "command": { "type": "string", "minLength": 1 },
        "evidencePath": { "$ref": "#/$defs/path" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
