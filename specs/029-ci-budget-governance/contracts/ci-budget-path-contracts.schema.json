{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hindermath/home-baseline/schemas/ci-budget-path-contracts.schema.json",
  "title": "Home Baseline CI Budget Path Contract Registry",
  "$comment": "This is the design contract for the sole runtime path-contract source at scripts/config/ci-budget-path-contracts.json. Gate references are validated against the profile registry; product-job references are validated against the workflow templates. A second embedded pathContracts source is forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryVersion",
    "pathContracts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "pathContracts": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/pathContract" },
      "allOf": [
        { "contains": { "properties": { "category": { "const": "build" } }, "required": ["category"] } },
        { "contains": { "properties": { "category": { "const": "security" } }, "required": ["category"] } },
        { "contains": { "properties": { "category": { "const": "governance" } }, "required": ["category"] } },
        { "contains": { "properties": { "category": { "const": "dependency" } }, "required": ["category"] } },
        { "contains": { "properties": { "category": { "const": "product" } }, "required": ["category"] } },
        { "contains": { "properties": { "category": { "const": "documentation" } }, "required": ["category"] } }
      ]
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "relativePattern": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|^[A-Za-z]:|(^|/)\\.\\.(/|$)|[\\r\\n\\u0000])" }
    },
    "pathContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pathContractId",
        "category",
        "includePatterns",
        "excludePatterns",
        "gateIds"
      ],
      "properties": {
        "pathContractId": { "$ref": "#/$defs/stableId" },
        "category": {
          "enum": [
            "build",
            "security",
            "governance",
            "dependency",
            "product",
            "documentation"
          ]
        },
        "includePatterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePattern" }
        },
        "excludePatterns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePattern" }
        },
        "gateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "productJobId": { "$ref": "#/$defs/stableId" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "category": { "const": "product" } },
            "required": ["category"]
          },
          "then": { "required": ["productJobId"] },
          "else": { "not": { "required": ["productJobId"] } }
        }
      ]
    }
  }
}
