  "decisions": [
    {
      "id": "IAD001",
      "status": "Answered",
      "question": "Bleiben Intake-Identitaet, Zielpfad und Reihenfolge erhalten?",
      "answer": "Ja. Intake-ID 7653c34f-9105-4128-97d7-814723b30b59, Zielpfad und sichtbare Position 5 bleiben unveraendert.",
      "evidence": "Die Benutzeranweisung verlangt bei notwendiger Aktualisierung denselben Intake; der Series-Vertrag waehlt Position 5 weiterhin bevorzugt aus."
    },
    {
      "id": "IAD002",
      "status": "Answered",
      "question": "Welches Preset-Modell gilt?",
      "answer": "Oeffentliches Acht-Preset-Standardprofil plus drei optionale Intake-Presets im verwalteten Elf-Preset-Flottenprofil.",
      "evidence": "Constitution 1.20.1 und `specify preset list` am 2026-08-02."
    },
    {
      "id": "IAD003",
      "status": "Answered",
      "question": "Wird eine neue Mapping-Datei erstellt?",
      "answer": "Nein. Die vorhandene Mapping-Datei 1.2.0 der Baseline 3.2.0 wird geprueft und nur finding-basiert gehaertet.",
      "evidence": "Der Review IR002 belegt die bereits vorhandene kanonische Zuordnungsdatei."
    },
    {
      "id": "IAD004",
      "status": "Answered",
      "question": "Welche Zielgruppen- und Dokumentationsbasis ist verbindlich?",
      "answer": "Vier IT-Ausbildungsberufe ab Jahr 1, Deutsch zuerst/Englisch danach, CEFR B2, Begriffserklaerung, text-first, Programmierung #include<everyone>, WCAG 2.2 AA und der Documentation-Impact-Vertrag.",
      "evidence": "AGENTS.md und docs/documentation-governance.md am aktuellen Head."
    },
    {
      "id": "IAD005",
      "status": "Answered",
      "question": "Welche spaetere Arbeit bleibt ausserhalb von Position 5?",
      "answer": "Assurance Gap Audit, neues Assurance-Preset, Baseline 3.3.0 und ABSDD-Adoption auf den Positionen 14 bis 17.",
      "evidence": "Aktuelles Series-Manifest und Lastenheft_Abarbeitungsreihenfolge.md."
    },
    {
      "id": "IAD006",
      "status": "Answered",
      "question": "Welche Delivery Authority traegt der kopierbare autonome Prompt?",
      "answer": "MergeAndSync fuer genau dieses Feature; kein impliziter Admin-Bypass, keine Secret- oder Provider-Administration und kein Folgelauf.",
      "evidence": "Stehende Benutzeranweisung fuer weitere Auftraege und die im Intake ausdruecklich begrenzte Authority."
    }
