# Home-Verzeichnis: Whitelist-Ansatz
# Alles wird ignoriert; nur explizit aufgeführte Dateien/Verzeichnisse werden getrackt.

# --- Alles ignorieren ----------------------------------------------------------
/*
/.*

# --- Explizit erlaubt (sicher, kein Secret-Risiko) ----------------------------

# Diese Datei selbst
!.gitignore

# Git-Globalkonfiguration (enthält keine Credentials)
!.gitconfig

# Bootstrap- und Utility-Scripts
!scripts/

# Dokumentation und KI-Agenten-Anweisungsdateien
!README.md
!README.en.md
!CHANGELOG.md
!LICENSE
!release-please-config.json
!.release-please-manifest.json
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!.github/
!.github/copilot-instructions.md
!.github/agents/
!.github/prompts/
!.github/workflows/
!.github/workflows/homogeneity-check.yml
!.github/workflows/release-please.yml

# Lastenheft-Dateien und Spezifikationen (alle Ebenen)
!Lastenheft*.md
!Pflichtenheft.md
!requirements/
!requirements/**
!docs/
!STATS-archive*.md
!specs/
!constitution.md
!mac-test-output.txt
!linux-test-output.txt
!windows-test-output.txt

# Spec-Kit Konfiguration und Templates
!.specify/
!.specify/init-options.json
!.specify/intake-authoring-policy.json
!.specify/memory/
!.specify/memory/constitution.md
!scripts/templates/
scripts/config/level2-repository-registry.json
scripts/config/level2-repository-registry.local.json
scripts/config/*repository-registry.local.json
!.specify/scripts/
!.specify/scripts/bash/
!.specify/templates/
!.specify/presets/
!.specify/presets/**
.specify/presets/.cache/
.specify/presets/.cache/**
.specify/integrations/.cache/
.specify/integrations/.cache/**

# Maschinenlokale autonome Lauf- und Acceptance-Evidence
# Machine-local autonomous run and acceptance evidence
.specify/runtime/

# Antigravity-/Codex-Agenten-Skills (keine Credentials)
!.agents/
.agents/*
!.agents/skills/
!.agents/skills/**

# Claude Spec-Kit Commands (nur commands/, NICHT root — root enthält history, sessions, cache)
!.claude/
.claude/*
!.claude/commands/
!.claude/skills/
!.claude/skills/speckit-*/
!.claude/skills/speckit-*/**

# Spec-Kit Verfassung (Duplikat-Eintrag entfernt — bereits oben definiert)

# --- Kritische Verzeichnisse / Dateien (niemals tracken) ----------------------
# .aws/          – AWS-Credentials
# .kube/         – Kubernetes-Configs mit Tokens
# .docker/       – Docker-Login-Tokens
# .ssh/          – SSH-Schlüssel
# .gnupg/        – GPG-Schlüssel
# .claude/       – Claude-History, Sessions, Cache (sensibel)
# .codex/        – auth.json, SQLite-DBs, Sessions (sensibel)
# .gemini/       – oauth_creds.json, google_accounts.json (sensibel)
# .junie/        – History, Logs (sensibel)
# .gradle/       – ggf. Signing-Keys
# .npmrc         – npm-Auth-Tokens
# .pypirc        – PyPI-Credentials

# opencode Spec-Kit Commands (nur commands/, NICHT root — root kann Cache enthalten)
!.opencode/
.opencode/*
!.opencode/command/
!.opencode/command/*.md

# macOS Finder metadata must never override the whitelist.
**/.DS_Store
docs/.vscode/settings.json
docs/learning-units/.vscode/settings.json

# Feature 018: lokale .NET-TUI-Ausgaben und Laufzeit-Cache
# Feature 018: local .NET TUI output and runtime cache
scripts/lib/maintenance-tui/**/bin/
scripts/lib/maintenance-tui/**/obj/
scripts/lib/maintenance-tui/.build/
scripts/lib/maintenance-tui/.cache/
**/__pycache__/
**/*.pyc
